{
  "schemaVersion": 1,
  "id": "${id}",
  "name": "${name}",
  "version": "${version}",
  "authors": ["${authors}"],
  "contributors": ["${contributors}"],
  "contact": {
    "sources": "${sources_url}",
    "issues": "${issues_url}",
    "homepage": "${homepage_url}"
  },
  "description": "${description}",
  "icon": "assets/supplemental_patches/icon.png",
  "license": "${license}",
  "environment": "*",
  "accessWidener": "aw/${minecraft}.accesswidener",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "${group}.${id}.platforms.fabric.FabricClientEntrypoint"
      }
    ]
  },
  "mixins": [
    "${id}.mixins.json"
  ],
  "custom": {
    "modmenu": {
      "badges": [ "client" ]
    }
  },${dependencies}
}
